# Systemd unit for docker-compose (optional)
# Save as /etc/systemd/system/android-rat.service on the server
# This is an example to auto-start docker-compose stack at boot
[Unit]
Description=Android-rat docker-compose
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/android-rat
ExecStart=/usr/bin/docker-compose up -d
ExecStop=/usr/bin/docker-compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
